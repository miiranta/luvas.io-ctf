{
  "name": "jogo-seguranca-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor do jogo de vulnerabilidades de SGBD, estilo LeetCode (aula de Segurança, MC536)",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning dist/index.js",
    "test:e2e": "NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" tsx e2e/e2e.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
